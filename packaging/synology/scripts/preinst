#!/bin/sh
set -eu
[ "$(uname -m)" = aarch64 ] || { echo 'ARM64 NAS required'; exit 1; }
id MediaServer >/dev/null
[ -s /usr/local/etc/nas-media-folders/config.json ] || { echo 'Run the documented setup or migration helper over SSH first'; exit 1; }
systemctl is-active --quiet nas-jelly-lite.service && { echo 'Stop the legacy service first'; exit 1; }
exit 0
